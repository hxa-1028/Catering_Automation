# Copy to .env for local development. Do not commit .env.
# Copy to .env for native development. Do not store secrets here.
# Docker Compose reads secret values from files under docker/secrets/ instead.
CATERING_APP_ENV=development
CATERING_APP_PORT=8080
CATERING_LOG_LEVEL=INFO
# An explicit URL is for native development only. The container runtime builds
# its URL from the db_password Compose secret.
CATERING_DATABASE_URL=
CATERING_DATABASE_HOST=db
CATERING_DATABASE_PORT=5432
CATERING_DATABASE_NAME=catering
CATERING_DATABASE_USER=catering
CATERING_DB_PASSWORD_SECRET_FILE=/run/secrets/db_password
CATERING_LLM_API_KEY_SECRET_FILE=/run/secrets/llm_api_key
CATERING_GOTENBERG_URL=http://docconv:3000
